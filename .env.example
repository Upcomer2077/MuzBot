# FOR PRODUCTION SHOULD BE CALLED .env.dist (1) or .env (2)
# REQUIRED
BOT_TOKEN = "666" #Telegram bot token
CHANNEL_STORAGE_ID = "-1000000000" # Telegram channel id int-like str or int

#OPTIONAL
TRACKS_PER_LIMIT = 5 #  MIN 5 int
QUERY_DOWNLOAD_LIMIT_SECS = 30 # MIN 30 int

PLAYLIST_DOWNLOAD_COOLDOWN_SECS = 20 # MIN 20 int
#Limit of tracks in playlist that can be pulled on current machine. Recommended to set ±50 or less for better performance
PLAYLIST_MAX_TRACKS = 0 #DEFAULT 0 (max) int

BACKUP_EVERY_N_DAYS = 2 # MIN 1 DEFAULT 2 int
LOKI_URL = "http://<docker_container_name or host>:3100/loki/api/v1/push"

CPU_COUNT = 0 #0 - MAX units int
DB_NAME="db2" # db name without extension str

EXPERIMENTAL = 0 # int (0 or 1): toggles experimental
DEBUG = 0 # int (0 or 1): toggles logs

TZ = "Europe/Minsk"