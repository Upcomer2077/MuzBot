# FOR PRODUCTION SHOULD BE CALLED .env.dist (1) or .env (2)
# REQUIRED

#Telegram bot token
BOT_TOKEN = "666"
# Telegram system channel id for caching songs and backups
CHANNEL_STORAGE_ID = "-1000000000" #  int-like str or int

#OPTIONAL

#Single (track) download request limit per user
TRACKS_PER_LIMIT = 5 #  MIN 5 int
#Single download cooldown (flood wait)
QUERY_DOWNLOAD_LIMIT_SECS = 30 # MIN 30 int

#Playlist download request limit per user
PLAYLISTS_LIMIT = 1 #int DEFAULT 1
#Playlist download cooldown (flood wait)
PLAYLIST_DOWNLOAD_COOLDOWN_SECS = 20 # MIN 20 int
#Limit of tracks in playlist that can be pulled on current machine. Recommended to set ±50 or less for better performance
PLAYLIST_MAX_TRACKS = 0 #DEFAULT 0 (max) int

#Interval of making database file backups.
BACKUP_EVERY_N_DAYS = 2 # MIN 1 DEFAULT 2 int

LOKI_URL = "http://<docker_container_name or host>:3100/loki/api/v1/push"

#Amount of cores that can be used by app. Uses N-1 cores for converting music and 1 for bot event loop
#Highly recommended to have 2+ cores at least
CPU_COUNT = 0 #0 (MAX) int
#Optional name of database file
DB_NAME="db2" # db name without extension str

#Toggles experimental features (alpha and beta versions)
EXPERIMENTAL = 0 # int (0 or 1)
#Toggles logs level and some dev features
DEBUG = 0 # int (0 or 1)

#Time zone
TZ = "Europe/Minsk"