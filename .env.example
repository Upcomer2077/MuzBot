# FOR PRODUCTION SHOULD BE CALLED .env.dist (1) or .env (2)
# REQUIRED
BOT_TOKEN = "666"
# SEMI-REQUIRED
TRACKS_PER_LIMIT = 5 # DEFAULT 5 MIN 5
QUERY_DOWNLOAD_LIMIT_SECS = 30 #DEFAULT 30 MIN 30
#OPTIONAL
CPU_COUNT = 0 #0 - MAX units
DB_NAME="db2" # db name without extension
LOKI_URL = "http://<docker_container_name or host>:3100/loki/api/v1/push"
REPLY_DISAPPEAR_TIMEOUT = 60 # Time until song's reply markup will disappear DEFAULT 30 MIN 30
EXPERIMENTAL = 0 # int (0 or 1): toggles experimental